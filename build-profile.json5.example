{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "signing/OrgTasksDebug.cer",
          "keyAlias": "orgTasksKey",
          "keyPassword": "keychain://org-tasks-signing/development",
          "profile": "signing/OrgTasksDebugProfileDebug.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "signing/org-tasks.p12",
          "storePassword": "keychain://org-tasks-signing/development"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "6.1.1(24)",
        "runtimeOS": "HarmonyOS",
        "targetSdkVersion": "6.1.1(24)",
        "buildOption": {
          "strictMode": {
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
