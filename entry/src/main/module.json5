{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ],
        "metadata": [
          {
            "name": "ohos.ability.shortcuts",
            "resource": "$profile:capture_shortcuts"
          }
        ]
      },
      {
        "name": "CaptureAbility",
        "srcEntry": "./ets/entryability/CaptureAbility.ets",
        "description": "$string:capture_description",
        "icon": "$media:app_icon",
        "label": "$string:capture_label",
        "startWindowIcon": "$media:capture_start_icon",
        "startWindowBackground": "$color:capture_start_background",
        "launchType": "singleton",
        "exported": true,
        "removeMissionAfterTerminate": true,
        "excludeFromMissions": true,
        "skills": [
          {
            "actions": [
              "ohos.want.action.viewData"
            ],
            "entities": [
              "entity.system.browsable"
            ],
            "uris": [
              {
                "scheme": "orgtasks",
                "host": "capture"
              }
            ]
          }
        ]
      },
      {
        "name": "ShareLocationAbility",
        "srcEntry": "./ets/entryability/ShareLocationAbility.ets",
        "description": "从地图分享地点创建或更新任务",
        "icon": "$media:app_icon",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "launchType": "singleton",
        "exported": false
      }
    ],
    "extensionAbilities": [
      {
        "name": "SyncWorkExtension",
        "srcEntry": "./ets/entryability/SyncWorkExtension.ets",
        "type": "workScheduler",
        "description": "后台定时同步 org 任务到日历"
      },
      {
        "name": "CaptureFormExtension",
        "srcEntry": "./ets/entryability/CaptureFormExtension.ets",
        "type": "form",
        "label": "$string:capture_label",
        "description": "$string:capture_card_description",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:capture_forms"
          }
        ]
      },
      {
        "name": "MemoFormExtension",
        "srcEntry": "./ets/entryability/MemoFormExtension.ets",
        "type": "form",
        "label": "$string:memo_card_label",
        "description": "$string:memo_card_description",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:memo_forms"
          }
        ]
      },
      {
        "name": "CaptureShareExtension",
        "srcEntry": "./ets/entryability/CaptureShareExtension.ets",
        "type": "share",
        "description": "$string:capture_description",
        "icon": "$media:app_icon",
        "exported": true,
        "skills": [
          {
            "actions": [
              "ohos.want.action.sendData"
            ],
            "uris": [
              {
                "scheme": "file",
                "utd": "general.plain-text",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "utd": "general.hyperlink",
                "maxFileSupported": 1
              }
            ]
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.STORE_PERSISTENT_DATA"
      },
      {
        "name": "ohos.permission.READ_CALENDAR",
        "reason": "$string:calendar_permission_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.WRITE_CALENDAR",
        "reason": "$string:calendar_permission_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.READ_MEDIA",
        "reason": "$string:file_permission_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.WRITE_MEDIA",
        "reason": "$string:file_permission_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING",
        "reason": "$string:background_permission_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:capture_microphone_reason",
        "usedScene": {
          "abilities": [
            "CaptureAbility"
          ],
          "when": "inuse"
        }
      }
    ],
    "metadata": [
      {
        "name": "ohos.insightIntent",
        "resource": "$profile:insight_intent"
      }
    ]
  }
}
