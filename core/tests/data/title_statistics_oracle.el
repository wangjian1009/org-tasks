;;; title_statistics_oracle.el --- 从 Org 生成统计更新的参考快照 -*- lexical-binding: t; -*-

(require 'org)
(require 'json)
(let* ((target (expand-file-name "title_statistics_emacs.json" (file-name-directory load-file-name)))
       (json-array-type 'list)
       (json-object-type 'alist)
       (cases (alist-get 'cases (json-read-file target)))
       (org-todo-keywords '((sequence "TODO" "|" "DONE")))
       (org-hierarchical-todo-statistics t)
       (org-checkbox-hierarchical-statistics t)
       (org-provide-todo-statistics t)
       (org-use-property-inheritance nil)
       (org-auto-align-tags nil)
       (org-log-done nil)
       (org-log-repeat nil)
       (org-log-into-drawer nil)
       (org-todo-state-tags-triggers nil)
       (org-after-todo-statistics-hook nil)
       (org-todo-statistics-hook nil))
  (dolist (case cases)
    (with-temp-buffer
      (insert (alist-get 'source case))
      (org-mode)
      (dolist (action (alist-get 'actions case))
        (goto-char (point-min))
        (dotimes (_ (1+ (alist-get 'index action)))
          (re-search-forward org-heading-regexp nil t))
        (beginning-of-line)
        (pcase (alist-get 'type action)
          ("title"
           (org-edit-headline (alist-get 'value action))
           (beginning-of-line)
           (org-update-statistics-cookies nil))
          ("todo" (org-todo (or (alist-get 'value action) 'none)))
          ("checkbox"
           (re-search-forward "^[ \t]*- \\[.\\]" nil t)
           (beginning-of-line)
           (org-toggle-checkbox)))
        (setf (alist-get 'expected action) (buffer-substring-no-properties (point-min) (point-max))))))
  (with-temp-file target
    (insert (json-encode `((reference . "(org) Breaking Down Tasks; (org) Checkboxes")
                           (orgVersion . ,(org-version))
                           (cases . ,(vconcat cases)))))
    (json-pretty-print-buffer)))
