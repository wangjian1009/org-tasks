;;; task_state_oracle.el --- 从 Org Info 对应实现生成状态与重复任务参考 -*- lexical-binding: t; -*-
(require 'org)
(require 'json)
(require 'cl-lib)
(let* ((target (expand-file-name "task_state_emacs.json" (file-name-directory load-file-name)))
       (json-array-type 'list)
       (json-object-type 'alist)
       (json-key-type 'symbol)
       (json-null nil)
       (data (json-read-file target))
       (org-todo-keywords '((sequence "TODO" "|" "DONE")))
       (org-use-property-inheritance nil)
       (org-auto-align-tags nil)
       ;; 完成时间、普通状态与重复日志均默认关闭，由文件配置开启。
       (org-log-done nil)
       (org-log-repeat nil)
       (org-log-into-drawer nil)
       (org-log-states-order-reversed t)
       (org-todo-repeat-to-state nil)
       (org-todo-state-tags-triggers nil)
       (org-after-todo-statistics-hook nil)
       (org-todo-statistics-hook nil)
       (org-after-todo-state-change-hook nil)
       (org-todo-repeat-hook nil)
       (org-after-note-stored-hook nil)
       (org-clock-out-when-done nil)
       (org-adapt-indentation nil)
       (org-extend-today-until 0)
       (system-time-locale "C")
       (fixed (encode-time 0 34 12 11 11 2026))
       (org-overriding-default-time fixed)
       (original-time-less-p (symbol-function 'time-less-p)))
  (unless (alist-get 'cases data) (error "参考样例不能为空"))
  (save-window-excursion
    (cl-letf (((symbol-function 'current-time) (lambda () fixed))
              ((symbol-function 'org-current-effective-time) (lambda () fixed))
              ((symbol-function 'org-today) (lambda () (time-to-days fixed)))
              ((symbol-function 'org-timestamp-to-now)
               (lambda (stamp &optional seconds)
                 (if seconds
                     (- (float-time (org-time-string-to-time stamp)) (float-time fixed))
                   (- (time-to-days (org-time-string-to-time stamp)) (time-to-days fixed)))))
              ((symbol-function 'time-less-p)
               (lambda (a b) (funcall original-time-less-p (or a fixed) (or b fixed))))
              ((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
      (dolist (case (alist-get 'cases data))
        (with-temp-buffer
          (insert (alist-get 'source case))
          (org-mode)
          (goto-char (point-min))
          (re-search-forward "^\\*+ .*Task")
          (beginning-of-line)
          (dolist (action (alist-get 'actions case))
            (let ((org-log-setup nil)
                  (org-log-note-marker (make-marker))
                  (org-log-note-return-to (point-marker))
                  (org-log-note-window-configuration (current-window-configuration))
                  (post-command-hook nil))
              (org-todo (or (alist-get 'state action) 'none))
              (when org-log-setup
                (with-temp-buffer (org-store-log-note)))
              (setf (alist-get 'expected action)
                    (buffer-substring-no-properties (point-min) (point-max)))))))))
  (setf (alist-get 'orgVersion data) (org-version))
  (with-temp-file target
    (insert (json-encode data))
    (json-pretty-print-buffer)))
